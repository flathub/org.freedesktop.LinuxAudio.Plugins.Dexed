{
    "id": "org.freedesktop.LinuxAudio.Plugins.Dexed",
    "branch": "26.08",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//26.08",
    "build-extension": true,
    "build-options": {
        "prefix": "/app/extensions/Plugins/Dexed",
        "prepend-path": "/app/extensions/Plugins/Dexed/bin"
    },
    "modules": [
        {
            "name": "dexed",
            "buildsystem": "cmake-ninja",
            "no-make-install": true,
            "config-opts": [
                "-DJUCE_COPY_PLUGIN_AFTER_BUILD=OFF",
                "-DBUILD_ID=1.1.0"
            ],
            "post-install": [
                "install -d ${FLATPAK_DEST}/vst3",
                "cp -R source/Dexed_artefacts/VST3/Dexed.vst3 ${FLATPAK_DEST}/vst3",
                "install -Dm755 source/Dexed_artefacts/CLAP/Dexed.clap -t ${FLATPAK_DEST}/clap",
                "strip --strip-unneeded ${FLATPAK_DEST}/vst3/Dexed.vst3/Contents/*/Dexed.so",
                "strip --strip-unneeded ${FLATPAK_DEST}/clap/*.clap",
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.Dexed.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/asb2m10/dexed.git",
                    "tag": "v1.1.0",
                    "commit": "fea2f0f0f2c397799f59b27eb11c038cd34b22c5"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.Dexed.metainfo.xml"
                }
            ]
        }
    ]
}
